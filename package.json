{
  "name": "pi-llama-swap-provider",
  "version": "0.1.0",
  "description": "Dynamic llama-swap provider for pi using the OpenAI Responses API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samh/pi-llama-swap-provider.git"
  },
  "homepage": "https://github.com/samh/pi-llama-swap-provider#readme",
  "bugs": {
    "url": "https://github.com/samh/pi-llama-swap-provider/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "llama-swap",
    "llama.cpp"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/live.test.ts",
    "test:live": "RUN_LLAMA_SWAP_LIVE=1 vitest run test/live.test.ts",
    "verify": "npm run typecheck && npm test",
    "verify:release": "npm run verify && npm run test:live && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
